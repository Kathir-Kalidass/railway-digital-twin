MQTT_DASHBOARD_PASS=dashboard-dev-pass
JWT_SECRET=dev-insecure-secret-change-me
VIEWER_PASSWORD=viewer-dev-pass
OPERATOR_PASSWORD=operator-dev-pass
ADMIN_PASSWORD=admin-dev-pass
